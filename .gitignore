# Secrets / local environment — NEVER commit these
.env
.env.*
!.env.example

# JWT signing keys. The private key must never be committed; generate a
# keypair per environment with scripts/generate_jwt_keys.py. The public key is
# not sensitive but lives inline in kong.yml, so it isn't needed here either.
keys/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS noise
.DS_Store
Thumbs.db

# Audit trail runtime data (bind-mounted from audit-service, see
# docker-compose.yml's audit-service volume) — generated at runtime, not
# source.
audit-logs/*.log
audit-logs/*.db
audit-logs/attachments/
