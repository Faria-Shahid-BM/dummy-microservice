# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.

# Base URL of an OpenAI-compatible chat completions API.
# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Model used for field extraction and observation generation.
LLM_MODEL_EXTRACTION=gpt-4o-mini

# Model used for vision-OCR transcription of scanned PDF pages.
LLM_MODEL_VISION=gpt-4o-mini
